{
  "name": "chaintorque-monorepo",
  "version": "1.0.0",
  "description": "ChainTorque Web3 Engineering Platform - Monorepo",
  "private": true,
  "workspaces": [
    "Landing Page (Frontend)",
    "Marketplace (Frontend)",
    "backend",
    "CAD (Frontend)"
  ],
  "scripts": {
    "dev": "bun run --bun concurrently --names \"LP,MP,BE,CAD\" --prefix-colors \"cyan,magenta,yellow,green\" \"bun run dev:landing\" \"bun run dev:marketplace\" \"bun run dev:backend\" \"bun run dev:cad\"",
    "dev:core": "bun run --bun concurrently --names \"LP,MP,BE\" --prefix-colors \"cyan,magenta,yellow\" \"bun run dev:landing\" \"bun run dev:marketplace\" \"bun run dev:backend\"",
    "build": "bun run concurrently --silent \"bun run build:landing\" \"bun run build:marketplace\" \"bun run build:backend\" \"bun run build:cad\"",
    "start": "NODE_ENV=production bun run concurrently --silent \"bun run start:marketplace\" \"bun run start:backend\"",
    "test": "bun run test:contracts",
    "lint": "bun run lint:frontend",
    "format": "bun x prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "bun x rimraf node_modules **/node_modules",
    "update": "bun update",
    "deploy:local": "cd backend && bun x hardhat run scripts/deploy.js --network hardhat",
    "deploy:sepolia": "cd backend && bun x hardhat run scripts/deploy.js --network sepolia",
    "dev:landing": "cd \"Landing Page (Frontend)\" && bun run dev",
    "dev:marketplace": "cd \"Marketplace (Frontend)\" && bun run dev",
    "dev:backend": "cd backend && cross-env PORT=5001 bun run dev",
    "dev:cad": "cd \"CAD (Frontend)\" && bun run dev",
    "build:landing": "cd \"Landing Page (Frontend)\" && npm run build",
    "build:marketplace": "cd \"Marketplace (Frontend)\" && npm run build",
    "build:backend": "echo 'Backend ready (no build step)'",
    "build:cad": "cd \"CAD (Frontend)\" && GENERATE_SOURCEMAP=false npm run build",
    "test:contracts": "cd backend && bun x hardhat test",
    "lint:frontend": "bun x eslint \"*/src/**/*.{js,jsx,ts,tsx}\" --report-unused-disable-directives --max-warnings 0"
  },
  "keywords": [
    "web3",
    "cad",
    "marketplace",
    "blockchain",
    "engineering",
    "monorepo"
  ],
  "author": "Archisman Pal",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.11.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "hardhat": "^2.28.6",
    "serve": "^14.2.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@gsap/react": "^2.1.2",
    "@lighthouse-web3/sdk": "^0.4.5",
    "@metamask/providers": "^22.1.1",
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "@openzeppelin/contracts": "^4.9.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-query": "^4.44.0",
    "assert": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.15.2",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "ethers": "^5.8.0",
    "express": "^4.22.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "helmet": "^7.2.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.263.1",
    "mongoose": "^8.23.1",
    "multer": "^1.4.5-lts.2",
    "next-themes": "^0.2.1",
    "nodemon": "^3.1.14",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.13",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-refresh": "^0.14.2",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "sonner": "^1.7.4",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.179.1",
    "three-stdlib": "^2.36.1",
    "util": "^0.12.5",
    "web-vitals": "^5.2.0"
  }
}